# GUNUCO Delivery Partner — public Expo env (safe for client bundles)

# Data source: mock | api
EXPO_PUBLIC_DATA_MODE=mock

# Enable UI test helpers (never true in production builds)
EXPO_PUBLIC_UI_TEST_MODE=true

# Mock scenario when UI test mode is on (see src/config/scenarios.ts)
# Examples: default, onboarding, pending-verification, approved, offline, online
EXPO_PUBLIC_UI_TEST_SCENARIO=default

# App environment: development | preview | production
# production forces API mode and disables UI test mode
EXPO_PUBLIC_APP_ENV=development

# REST API base URL (required when EXPO_PUBLIC_DATA_MODE=api)
EXPO_PUBLIC_API_BASE_URL=
